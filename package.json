{
  "name": "audition_app",
  "productName": "Auditorium",
  "version": "1.6.0",
  "description": "Audition-class desktop audio editor: waveform and spectral editing, 22 effects, noise reduction, recording, multitrack mixing, tempo detection and auto-remix.",
  "author": "Auditorium contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev-server-only": "vite --port 3005 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "smoke": "node scripts/e2e-smoke.cjs",
    "make-test-tone": "node scripts/make-test-tone.cjs",
    "make-test-beat": "node scripts/make-test-beat.cjs",
    "make-test-abab": "node scripts/make-test-abab.cjs",
    "electron": "electron .",
    "gen-icon": "node scripts/gen-icon.cjs",
    "build:win": "node scripts/clean-release.cjs && npm run build && node scripts/build-installer.cjs && node scripts/gen-readme-txt.cjs"
  },
  "build": {
    "appId": "com.auditorium.app",
    "productName": "Auditorium",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/**/*.test.cjs",
      "assets/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Auditorium"
    }
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@napi-rs/canvas": "^0.1.100",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lucide-react": "^1.24.0",
    "playwright": "^1.61.1",
    "png-to-ico": "^2.1.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "onnxruntime-node": "1.27.0"
  }
}
